# ==============================================================
# Antigravity Telegram Bridge Configuration
# ==============================================================

# 1. Telegram Bot Token (Lấy từ @BotFather trên Telegram)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Telegram User ID được phép điều khiển (Lấy từ @userinfobot trên Telegram)
# Có thể nhập nhiều ID phân cách bởi dấu phẩy, ví dụ: 5889330916,123456789
ALLOWED_USER_IDS=5889330916

# 3. Cổng DevTools (CDP) của Antigravity IDE (Mặc định: 57061)
# Hệ thống sẽ tự động quét và nhận diện cổng này nếu để trống
CDP_PORT=57061

# 4. (Tùy chọn) Danh sách đường dẫn dự án thường dùng (phân cách bởi dấu ;)
# KNOWN_PROJECT_PATHS=D:\my-project;C:\Users\username\Projects\app
